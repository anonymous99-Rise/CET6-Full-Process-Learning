# ============================================================
#  CET-6 全流程学习 · Docker 部署配置模板
#
#  用法（三步）：
#    1) copy .env.example .env        Windows
#       cp   .env.example .env        macOS / Linux
#    2) 编辑 .env，填好 DEEPSEEK_API_KEY
#    3) docker compose up -d --build
#       然后打开总入口：http://127.0.0.1:8080
#
#  规则：
#    · docker compose 会自动读取本文件（即 .env），这里填的值会注入容器；
#    · 留空或删掉某一行 → 用 compose 里的默认值；密钥留空时，
#      各应用目录自己的 .env 仍然生效（本文件同名项优先级更高）；
#    · .env 已被 .gitignore 忽略，不会上传。
#      ⚠️ 请勿把真实密钥写进 .env.example。
# ============================================================

# ---------- DeepSeek 密钥（只填这一处，7 个应用共用）----------
# 获取：https://platform.deepseek.com/
# 留空也能启动（页面提示「Key 未配置」），但出题 / 评分不可用。
DEEPSEEK_API_KEY=

# ---------- MiniMax 引擎（可选；与 DeepSeek 二选一，也可以都配随时切）----------
# 获取：MiniMax 开放平台控制台；接口地址为 OpenAI 兼容端点，可在配置页修改
# （预设 https://api.minimaxi.com/v1/text/chatcompletion_v2 已实测可达，
#   但未用真实密钥验证过完整鉴权；首次请到配置页点「测试连通性」）
MINIMAX_API_KEY=

# 覆盖默认模型（默认 deepseek-v4-flash；页面设置区还能临时切换）。
# 写在这里对 7 个应用统一生效；也可以写在各应用目录自己的 .env 里（v3.4.0 起同样生效）。
# DEEPSEEK_MODEL=deepseek-chat

# 生成后是否跑「四六级大纲词表」超纲词校验（1=开，0=关；词表缺失自动跳过）
# CET_VOCAB_CHECK=1


# ---------- 访问控制（登录）----------
# 打开后：所有应用（含配置页与门户）都要先登录才能用。
# 登录一次即可访问全部端口 —— 同一台机器上的 8 个应用共用会话 Cookie（Cookie 不区分端口）。
AUTH_ENABLED=1
AUTH_USER=exam
AUTH_PASSWORD=@*VID@Ldu8

# 会话签名密钥：留空则按账号密码派生（改密码即让旧会话失效）；想固定就填一段随机串
# AUTH_SECRET=
# 登录有效期（天，默认 7）
# AUTH_SESSION_DAYS=7

# ---------- 访问地址与端口 ----------
# 监听地址：127.0.0.1 = 只有本机能访问（默认，与直接 python app.py 一致）
#           0.0.0.0 = 局域网内其他设备（手机 / 平板）也能访问
# ⚠️ 改成 0.0.0.0 后，局域网里任何人都能用你的 Key 出题（应用没有登录鉴权），
#    建议只在可信的家庭 / 宿舍网络里使用。
BIND_ADDR=127.0.0.1

# 总入口（导航面板）端口
PORTAL_PORT=8080

# 引擎与密钥配置面板端口（可视化配置 DeepSeek / MiniMax、填密钥、测试连通性）
CONFIG_PORT=5562

# 允许非本机（局域网）在配置页写密钥：默认关闭。
# 关闭时——页面上的密钥保存按钮只在「本机部署」下可用，局域网设备能用但改不了。
# 开启前请确认网络可信（开着就等于把改密钥的权限交给了同网段所有人）。
# ALLOW_REMOTE_KEY_WRITE=1

# 可选的全局默认引擎（配置页保存的 settings.json 优先级更高；两者都没配则用 deepseek）
# AI_PROVIDER=minimax
# AI_MODEL=MiniMax-M2.7

# 容器运行身份（可选，仅 Linux 宿主需要关心）：
#   默认 root —— Windows / macOS 的 Docker Desktop 下最省事，不用改。
#   Linux 下若希望 my/ 里生成的练习归当前用户所有（而不是 root），
#   填 `id -u` 与 `id -g` 的值，例如：
# APP_USER=1000:1000

# 七个应用在宿主机上的端口（与 README 一致；端口被占用时改这里即可，
# 跳转链接会自动跟随，无需改任何代码）
LISTENING_PORT=5555
CLOZE_PORT=5556
LONGREAD_PORT=5557
CAREFULREAD_PORT=5558
TRANSLATE_PORT=5559
WRITING_PORT=5560
INTENSIVE_PORT=5561
