# ============================================================
#  CET-6 全流程学习 · 门户（nginx）
#
#  这里只做一件事：把门户端口收到的全部请求转给 config 应用。
#  门户页面、/go/ 跳转、/health/ 状态探测、/settings-api/、/offline/、
#  以及登录鉴权，全部由 config 应用（Flask）实现 —— 只有一份逻辑，
#  不会再出现「nginx 一套、裸机一套」的两份实现。
#
#  envsubst 只替换容器里真实存在的环境变量，$host/$uri 等运行时变量不受影响。
# ============================================================

resolver 127.0.0.11 valid=10s ipv6=off;   # Docker 内置 DNS：容器重建换 IP 后自动重新解析

server {
    listen 80;
    server_name _;
    charset utf-8;

    location / {
        set $up config:5562;
        proxy_pass http://$up;
        proxy_http_version 1.1;
        proxy_set_header Host $host;                 # 保留浏览器访问时用的主机名（/go/ 跳转要靠它）
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;                     # AI 生成可能较慢
        client_max_body_size 4m;
    }
}
